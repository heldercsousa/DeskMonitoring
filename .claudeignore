# =============================================================================
# .claudeignore — C:\Sync FolderSync + Camera Ecosystem
# Keeps Claude focused on Config\ scripts and task planning docs.
# Excludes logs, mirror, credentials, video recordings, and temp artifacts.
# =============================================================================

# ---------------------------------------------------------------------------
# Local mirror — large binary/media files, date-organized, gitignored already
# ---------------------------------------------------------------------------
Mirror/

# ---------------------------------------------------------------------------
# Log files — large, noisy, daily-rotating, not relevant for script editing
# OVERRIDE PATTERN: .claudeignore blocks auto-loading into context, but does NOT
# block the Grep and Read tools. To diagnose issues without loading all logs:
#   → Use /project:diagnose-logs  (greps only today's dated files for errors)
#   → Or use Grep tool directly on C:\Sync\Logs\<component>_YYYY-MM-DD.log
# This keeps normal sessions token-efficient while allowing targeted log reads.
# ---------------------------------------------------------------------------
Logs/

# ---------------------------------------------------------------------------
# Credential and sensitive config files
# ---------------------------------------------------------------------------
# Plaintext Backblaze B2 credentials — never expose to context window
Config/rclone.conf

# DPAPI-encrypted binary blobs — binary, meaningless without decryption
Config/credentials.enc
Config/alert_credentials.enc
Config/b2_creds.dpapi
Config/cam2_creds.dpapi

# Camera credentials — plaintext, ACL-protected, never expose to context
Config/cam2.conf

# ---------------------------------------------------------------------------
# FreeFileSync binary config — not human-editable plain text
# ---------------------------------------------------------------------------
Config/realtime.ffs_real

# ---------------------------------------------------------------------------
# ECOSYSTEM_REPORT.md — large reference doc (Section 15 = full script contents)
# Read explicitly with the Read tool when doing guide-sync (RULE 1 tasks).
# Auto-loading this file every session wastes hundreds of tokens.
# ---------------------------------------------------------------------------
Config/ECOSYSTEM_REPORT.md

# ---------------------------------------------------------------------------
# Evidence/ — forensic files, only needed during security investigations.
# Read with Read/Grep tools explicitly. Not needed in normal coding context.
# ---------------------------------------------------------------------------
Evidence/

# ---------------------------------------------------------------------------
# Source/ — external path mapping, not part of the repo
# ---------------------------------------------------------------------------
Source/

# ---------------------------------------------------------------------------
# Git internals
# ---------------------------------------------------------------------------
.git/

# ---------------------------------------------------------------------------
# Camera video recordings — large AVI files (motion clips)
# The Bois source dir and Mirror contain thousands of these
# ---------------------------------------------------------------------------
*.avi
*.mp4
*.mkv

# ---------------------------------------------------------------------------
# Runtime forensic artifacts and registry dumps at repo root level
# Root-anchored (leading slash) so Config/motion/*.txt guides remain visible
# ---------------------------------------------------------------------------
/*.txt
/*.reg
*.stackdump


# ---------------------------------------------------------------------------
# Temp files left by Claude Code editor — repo-wide pattern covers:
#   *.tmp.<PID>.<hash>  (e.g. setup_all.ps1.tmp.12784.1772863210786)
# Applies to root level, Config/, and any subdirectory
# ---------------------------------------------------------------------------
**/*.tmp.*

# ---------------------------------------------------------------------------
# Runtime state flags — written by start/stop scripts, not meaningful for editing
# ---------------------------------------------------------------------------
Config/.ecosystem_state
Config/.sync_failed



# ---------------------------------------------------------------------------
# PDF files left by Claude Code editor — repo-wide pattern covers:
#   *.pdf  
# Applies to root level and any subdirectory
# ---------------------------------------------------------------------------
*.pdf

# =============================================================================
# KEPT VISIBLE (not ignored):
#   Config/*.ps1            — the actual codebase (sync + camera)
#   Config/*.bat            — generated bat wrappers
#   Config/motion/*.md      — camera setup documentation
#   Config/motion/*.txt     — camera quick-start guides (visible because /*.txt
#                             is root-anchored, not recursive)
#   .claude/commands/*.md   — per-project slash commands
#   .claude/settings.json   — project MCP and permission config
#   Tasks/                  — implementation plan docs (MUST be visible)
#   .gitignore
#   CLAUDE.md
#   Backlog.md
# =============================================================================

