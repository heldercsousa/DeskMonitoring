{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(powershell -ExecutionPolicy Bypass -File \"C:\\Sync\\Config\\check_*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-ScheduledTask*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-Service*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-Process*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-NetFirewallRule*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-PnpDevice*\")",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(* rclone.conf *)",
      "Bash(* credentials.enc *)"
    ]
  },
  "env": {
    "RCLONE_EXE": "C:\\Tools\\Rclone\\rclone.exe",
    "NSSM_EXE": "C:\\Tools\\NSSM\\nssm.exe",
    "YAWCAM_EXE": "C:\\Program Files (x86)\\Yawcam\\Yawcam.exe",
    "YAWCAM_MONITOR": "C:\\Program Files (x86)\\Yawcam\\yawcam_monitor_v4.ps1",
    "SYNC_SOURCE": "C:\\Users\\helde\\Repos\\Bois",
    "SYNC_CONFIG": "C:\\Sync\\Config",
    "SYNC_LOGS": "C:\\Sync\\Logs",
    "SYNC_MIRROR": "C:\\Sync\\Mirror"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(.*git (add|commit).*)",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Sync\\.claude\\hooks\\rule6_integrity_check.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Sync\\Config\\parse_check_hook.ps1\"",
            "shell": "powershell"
          },
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Sync\\.claude\\hooks\\rule1_reminder.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Sync\\Config\\stop_commit_check.ps1\"",
            "shell": "powershell",
            "asyncRewake": true,
            "rewakeMessage": "Stop hook detected uncommitted changes:",
            "rewakeSummary": "Uncommitted changes need committing",
            "statusMessage": "Checking for uncommitted changes..."
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "threatintel": {
      "command": "npx",
      "args": ["-y", "mcp-threatintel-server"],
      "env": {},
      "_note": "Threat intelligence: Feodo Tracker works with no key; add OTX_API_KEY/ABUSEIPDB_API_KEY/GREYNOISE_API_KEY/ABUSECH_AUTH_KEY for full coverage. All free tiers available."
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Sync",
        "C:\\Sync\\Config",
        "C:\\Program Files (x86)\\Yawcam"
      ],
      "disabled": true,
      "_note": "Enable after: npm install -g @modelcontextprotocol/server-filesystem"
    },
    "win-cli": {
      "command": "npx",
      "args": ["-y", "win-cli-mcp-server"],
      "env": {
        "ALLOWED_COMMANDS": "powershell,Get-ScheduledTask,Get-Service,Get-Process,Get-PnpDevice",
        "SHELL": "powershell"
      },
      "disabled": true,
      "_note": "Enable after: npm install -g win-cli-mcp-server — adds native PowerShell tool (Get-PSVersion, OS info, etc.)"
    },
    "virustotal": {
      "command": "npx",
      "args": ["-y", "@burtthecoder/mcp-virustotal"],
      "env": {
        "VIRUSTOTAL_API_KEY": "${VIRUSTOTAL_API_KEY}"
      },
      "disabled": true,
      "_note": "T080 VirusTotal MCP (BurtTheCoder/mcp-virustotal): file/URL/domain/IP reports + relationship pivoting. ACTION FOR HELDER: 1) get free Public API key at virustotal.com (Profile > API key; 500 req/day, 4 req/min, non-commercial). 2) set OS env var VIRUSTOTAL_API_KEY (setx VIRUSTOTAL_API_KEY <key>) so it stays out of git. 3) set disabled=false. CAVEAT: never upload confidential files; analyze hashes/IOCs only, from trusted/forwarded logs."
    },
    "shodan": {
      "command": "npx",
      "args": ["-y", "@burtthecoder/mcp-shodan"],
      "env": {
        "SHODAN_API_KEY": "${SHODAN_API_KEY}"
      },
      "disabled": true,
      "_note": "T080 Shodan MCP (BurtTheCoder/mcp-shodan): host/IP recon, DNS, CVE/CPE intel. ACTION FOR HELDER: 1) get free API key at account.shodan.io. 2) set OS env var SHODAN_API_KEY (setx SHODAN_API_KEY <key>). 3) set disabled=false."
    },
    "cve": {
      "command": "python",
      "args": ["-m", "cve_mcp.server"],
      "cwd": "C:\\Tools\\cve-mcp-server",
      "env": {
        "NVD_API_KEY": "${NVD_API_KEY}",
        "SHODAN_KEY": "${SHODAN_API_KEY}",
        "VIRUSTOTAL_KEY": "${VIRUSTOTAL_API_KEY}",
        "ABUSEIPDB_KEY": "${ABUSEIPDB_API_KEY}",
        "GREYNOISE_API_KEY": "${GREYNOISE_API_KEY}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      },
      "disabled": true,
      "_note": "T080 CVE MCP Server (mukul975/cve-mcp-server): 27 tools / 21 APIs (NVD, EPSS, CISA KEV, MITRE ATT&CK, Shodan, VT, GreyNoise, AbuseIPDB, MalwareBazaar, ThreatFox, URLScan, OSV); 8 tools work keyless (EPSS, CISA KEV, OSV, ATT&CK, CWE, CVSS, Ransomwhere, NVD@reduced-rate). ACTION FOR HELDER: 1) git clone https://github.com/mukul975/cve-mcp-server.git C:\\Tools\\cve-mcp-server. 2) cd there, python -m venv .venv (or use uv), pip install -e . . 3) optional: set NVD_API_KEY/GITHUB_TOKEN OS env vars for higher rate limits (keys reused from VT/Shodan above). 4) set disabled=false. Empty ${VAR} = that API is simply unavailable; keyless tools still work."
    }
  }
}
