{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(powershell -ExecutionPolicy Bypass -File \"C:\\Sync\\Config\\check_*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-ScheduledTask*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-Service*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-Process*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-NetFirewallRule*\")",
      "Bash(powershell -ExecutionPolicy Bypass -Command \"Get-PnpDevice*\")",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(* rclone.conf *)",
      "Bash(* credentials.enc *)"
    ]
  },
  "env": {
    "RCLONE_EXE": "C:\\Tools\\Rclone\\rclone.exe",
    "NSSM_EXE": "C:\\Tools\\NSSM\\nssm.exe",
    "YAWCAM_EXE": "C:\\Program Files (x86)\\Yawcam\\Yawcam.exe",
    "YAWCAM_MONITOR": "C:\\Program Files (x86)\\Yawcam\\yawcam_monitor_v4.ps1",
    "SYNC_SOURCE": "C:\\Users\\helde\\Repos\\Bois",
    "SYNC_CONFIG": "C:\\Sync\\Config",
    "SYNC_LOGS": "C:\\Sync\\Logs",
    "SYNC_MIRROR": "C:\\Sync\\Mirror"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Sync\\Config\\parse_check_hook.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Sync\\Config\\stop_commit_check.ps1\"",
            "shell": "powershell",
            "asyncRewake": true,
            "rewakeMessage": "Stop hook detected uncommitted changes:",
            "rewakeSummary": "Uncommitted changes need committing",
            "statusMessage": "Checking for uncommitted changes..."
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "threatintel": {
      "command": "npx",
      "args": ["-y", "mcp-threatintel-server"],
      "env": {},
      "_note": "Threat intelligence: Feodo Tracker works with no key; add OTX_API_KEY/ABUSEIPDB_API_KEY/GREYNOISE_API_KEY/ABUSECH_AUTH_KEY for full coverage. All free tiers available."
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Sync",
        "C:\\Sync\\Config",
        "C:\\Program Files (x86)\\Yawcam"
      ],
      "disabled": true,
      "_note": "Enable after: npm install -g @modelcontextprotocol/server-filesystem"
    },
    "win-cli": {
      "command": "npx",
      "args": ["-y", "win-cli-mcp-server"],
      "env": {
        "ALLOWED_COMMANDS": "powershell,Get-ScheduledTask,Get-Service,Get-Process,Get-PnpDevice",
        "SHELL": "powershell"
      },
      "disabled": true,
      "_note": "Enable after: npm install -g win-cli-mcp-server — adds native PowerShell tool (Get-PSVersion, OS info, etc.)"
    }
  }
}
